# Environment Variable Template for E-Cell IET Lucknow
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SENTRY CONFIGURATION
# =============================================================================

# Sentry DSN (Data Source Name) - Required for error tracking
# Get this from your Sentry project settings: https://sentry.io/settings/[org]/projects/[project]/keys/
# This is safe to expose publicly as it's used for client-side error reporting
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn-here@o1234567890.ingest.sentry.io/1234567890

# Sentry Organization Slug - Required for source map uploads
# Found in your Sentry organization settings URL: https://sentry.io/settings/[org-slug]/
SENTRY_ORG=your-organization-slug

# Sentry Project Slug - Required for source map uploads
# Found in your Sentry project settings URL: https://sentry.io/settings/[org]/projects/[project-slug]/
SENTRY_PROJECT=your-project-slug

# Sentry Authentication Token - Required for source map uploads
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Needs: project:releases, project:write, org:read scopes
# KEEP THIS SECRET - Never commit this to version control
SENTRY_AUTH_TOKEN=your-auth-token-here

# =============================================================================
# SENTRY ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment name for error categorization
# Options: development, staging, production
SENTRY_ENVIRONMENT=development

# Release version for error correlation
# Can be git commit SHA, version number, or build number
# Example: 1.0.0, v2.1.3, abc123def, ${npm_package_version}
SENTRY_RELEASE=1.0.0

# Error sampling rate (0.0 to 1.0)
# 1.0 = capture all errors, 0.1 = capture 10% of errors
# Recommended: 1.0 for development, 0.1-0.3 for production
SENTRY_SAMPLE_RATE=1.0

# Performance monitoring sample rate (0.0 to 1.0)
# 1.0 = monitor all transactions, 0.1 = monitor 10% of transactions
# Recommended: 1.0 for development, 0.1 for production
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# SENTRY FEATURE FLAGS
# =============================================================================

# Enable/disable Sentry integration entirely
# Options: true, false
SENTRY_ENABLED=true

# Enable debug logging for Sentry (development only)
# Options: true, false
SENTRY_DEBUG=false

# Enable session replay feature (captures user interactions)
# Options: true, false
# Note: May impact performance and privacy
SENTRY_REPLAY_ENABLED=true

# Enable performance monitoring
# Options: true, false
SENTRY_PERFORMANCE_ENABLED=true

# =============================================================================
# SENTRY PRIVACY AND SECURITY
# =============================================================================

# Send personally identifiable information (PII) to Sentry
# Options: true, false
# Recommended: false for privacy compliance
SENTRY_SEND_DEFAULT_PII=false

# Attach stack traces to all messages
# Options: true, false
SENTRY_ATTACH_STACKTRACE=true

# Maximum number of breadcrumbs to collect
# Range: 0-100, Recommended: 50-100
SENTRY_MAX_BREADCRUMBS=50

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Site URL for SEO and canonical URLs
# Used for Open Graph, Twitter Cards, and sitemap generation
# Examples: https://ecell-iet-lucknow.vercel.app, https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://ecell-iet-lucknow.vercel.app

# =============================================================================
# EMAILJS CONFIGURATION - REQUIRED FOR CONTACT FORM
# =============================================================================

# EmailJS Service ID - Get from https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id

# EmailJS Admin Template ID - Template for admin notifications
NEXT_PUBLIC_EMAILJS_TEMPLATE_ADMIN=your_admin_template_id

# EmailJS Auto-Reply Template ID - Template for user auto-replies
NEXT_PUBLIC_EMAILJS_TEMPLATE_AUTO_REPLY=your_autoreply_template_id

# EmailJS Public Key - Get from https://dashboard.emailjs.com/admin/account
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable bundle analyzer
# Options: true, false
ANALYZE=false

# Disable Next.js telemetry
# Options: 1, 0
NEXT_TELEMETRY_DISABLED=1

# Disable Next.js development tools
# Options: true, false
NEXT_DISABLE_DEVTOOLS=false

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. SENTRY SETUP:
#    - Create account at https://sentry.io
#    - Create new project for Next.js
#    - Copy DSN from project settings
#    - Create auth token with required scopes
#    - Fill in organization and project slugs

# 2. ENVIRONMENT SETUP:
#    - Copy this file to .env.local
#    - Replace all placeholder values with actual values
#    - Never commit .env.local to version control
#    - Add .env.local to your .gitignore file

# 3. VERIFICATION:
#    - Run: npm run sentry:test (after setup)
#    - Check Sentry dashboard for test events
#    - Trigger an error to test error boundaries

# 4. PRODUCTION DEPLOYMENT:
#    - Set environment variables in your hosting platform
#    - Ensure SENTRY_AUTH_TOKEN is kept secret
#    - Use appropriate sample rates for production
#    - Set SENTRY_ENVIRONMENT to "production"

# =============================================================================
# SECURITY NOTES
# =============================================================================

# ⚠️  IMPORTANT SECURITY CONSIDERATIONS:
# 
# 1. NEVER commit .env.local or actual secrets to version control
# 2. SENTRY_AUTH_TOKEN should be kept secret and secure
# 3. Use different Sentry projects for different environments
# 4. Regularly rotate authentication tokens
# 5. Monitor Sentry usage to avoid quota overages
# 6. Review error data for sensitive information before sharing
# 7. Use appropriate sample rates to control data volume and costs

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Common Issues:
# 
# 1. "Sentry not capturing errors":
#    - Check NEXT_PUBLIC_SENTRY_DSN is correct and public
#    - Verify SENTRY_ENABLED=true
#    - Check browser console for Sentry initialization errors
# 
# 2. "Source maps not uploading":
#    - Verify SENTRY_AUTH_TOKEN has correct permissions
#    - Check SENTRY_ORG and SENTRY_PROJECT are correct
#    - Ensure you're building in production mode
# 
# 3. "Too many events":
#    - Reduce SENTRY_SAMPLE_RATE and SENTRY_TRACES_SAMPLE_RATE
#    - Implement better error filtering in beforeSend hooks
#    - Check for infinite loops or repeated errors
# 
# 4. "Performance issues":
#    - Disable SENTRY_REPLAY_ENABLED if not needed
#    - Reduce SENTRY_TRACES_SAMPLE_RATE
#    - Check SENTRY_MAX_BREADCRUMBS setting

# For more help, visit: https://docs.sentry.io/platforms/javascript/guides/nextjs/
