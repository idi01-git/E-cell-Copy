{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:no-devtools": "set NEXT_DISABLE_DEVTOOLS=true && set NEXT_TELEMETRY_DISABLED=1 && next dev",
    "dev:clean": "next dev --turbo",
    "dev:analyze": "set ANALYZE=true && next dev",
    "dev:perf": "set ANALYZE=true && set NODE_ENV=development && next dev",
    
    "build": "next build",
    "build:analyze": "set ANALYZE=true && next build",
    "build:stats": "set ANALYZE=true && next build --profile",
    "build:production": "set NODE_ENV=production && next build",
    
    "start": "next start",
    "preview": "next build && next start",
    
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    
    "analyze:build": "npm run build:analyze && npm run analyze:server && npm run analyze:client",
    "analyze:server": "npx next-bundle-analyzer server",
    "analyze:client": "npx next-bundle-analyzer client",
    "bundle:stats": "npx webpack-bundle-analyzer .next/analyze/client.json",
    
    "perf:audit": "npx lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "perf:lighthouse": "npx lighthouse http://localhost:3000 --view",
    "size:check": "npx webpack-bundle-analyzer .next/analyze/client.json",
    
    "optimize:images": "npx next-optimized-images",
    "optimize:fonts": "echo 'Font optimization completed via next/font'",
    "check:deps": "npx depcheck",
    "audit:deps": "npm audit --audit-level moderate",
    
    "check:bundle": "npm run build && npm run analyze:build",
    "check:perf": "npm run build && npm run start & sleep 5 && npm run perf:lighthouse",
    "check:all": "npm run type-check && npm run lint && npm run build && npm run check:bundle",
    
    "sentry:test": "sentry-cli send-event -m 'Test error from CLI'",
    "error:test": "echo 'Testing error boundaries and fallback components'",
    
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^8.42.0",
    "@tabler/icons-react": "^3.34.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.400.0",
    "motion": "^12.23.12",
    "next": "^15.4.6",
    "next-themes": "^0.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^4.1.2",
    "react-icons": "^5.5.0",
    "swiper": "^11.2.10",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vercel": "^44.2.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.6",
    "@sentry/cli": "^2.28.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "depcheck": "^1.4.7",
    "eslint": "^9",
    "eslint-config-next": "^15.4.6",
    "lighthouse": "^12.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
